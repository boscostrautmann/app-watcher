{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Apps Plist Schema",
  "description": "Schéma pour valider la configuration des applications autorisées par groupe dans apps.plist",
  "type": "object",
  "patternProperties": {
    "^[a-zA-Z0-9_]+$": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9._-]+$|^\\*$"
      }
    }
  },
  "additionalProperties": false
}